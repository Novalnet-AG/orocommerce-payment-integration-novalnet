{% block _novalnet_transaction_details_container_widget %}
	{% if transactionDetails.qrImage %}
		{{ 'novalnet.qr_image_text'|trans }}
		<img src={{ transactionDetails.qrImage }} alt="QR"/>
	{% endif %}
	{% if transactionDetails.paymentType in ['INSTALMENT_INVOICE', 'INSTALMENT_DIRECT_DEBIT_SEPA'] and transactionDetails.instalmentDetails %}
	<div>
		<span class="customer-info-grid__element-label">{{ 'novalnet.instalment_summary'|trans }}</span>
		<br><br>
		<table id="novalnet_instalment_table">
			<tr>
				<th>{{ 'novalnet.sno'|trans }}</th>
				<th>{{ 'novalnet.transaction_id'|trans }}</th>
				<th>{{ 'novalnet.amount'|trans }}</th>
				<th>{{ 'novalnet.next_instalment_date'|trans }}</th>
				<th>{{ 'novalnet.status'|trans }}</th>
			</tr>
			{% for key, value in transactionDetails.instalmentDetails['cycle_dates'] %}
			{% set tid  = transactionDetails.instalmentDetails[key].tid ? transactionDetails.instalmentDetails[key].tid : '' %}
			{% set instalmentRefundedAmount = transactionDetails.instalmentDetails[key]['refunded_amount']|default(0) %}
			
			{% if transactionDetails.status == 'DEACTIVATED' %}
				{% set cycleStatus  = 'CANCELLED' %}
			{% elseif tid != '' %}
				{% if instalmentRefundedAmount >= transactionDetails.instalmentDetails['cycle_amount'] %}
					{% set cycleStatus  = 'REFUNDED' %}
				{% else %}
					{% set cycleStatus  = 'COMPLETED' %}
				{% endif %}
			{% else %}
				{% set cycleStatus  = '-' %}
			{% endif %}
			
			{% if transactionDetails.instalmentDetails['cancel_type'] == 'cancel_all_cycles' %}
				{% if tid != '' %}
					{% set cycleStatus  = 'REFUNDED' %}
				{% else %}
					{% set cycleStatus  = 'CANCELLED' %}
				{% endif %}
			{% elseif transactionDetails.instalmentDetails['cancel_type'] == 'cancel_remaining_cycles' and tid == ''%}
					{% set cycleStatus  = 'CANCELLED' %}
			{% endif %}
					
			<tr>
				<td>{{ key }}</td>
				<td>{{ tid }}</td>
				
				{% set cycleAmount = transactionDetails.instalmentDetails['formatted_cycle_amount'] %}
				{% if key == transactionDetails.instalmentDetails['total_cycles'] %}
					{% set cycleAmount = transactionDetails.instalmentDetails['last_cycle_amount'] %}
				{% endif %}
				
				<td>{{ cycleAmount|oro_format_currency({'currency': transactionDetails.instalmentDetails['currency']}) }}</td>
				<td>{{ transactionDetails.instalmentDetails.cycle_dates[key + 1]|default('') }}</td>
				<td>{{ cycleStatus }}</td>
			</tr>
			{% endfor %}
		</table>
	</div>
	<br>
	{% endif %}
{% endblock %}
